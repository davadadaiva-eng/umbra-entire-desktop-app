[TEMPLATE]
# Copy this file to .env and fill in your values. .env is gitignored.
# The Gemini API key pre-fills the default AI provider in Settings.
VITE_GEMINI_KEY=

# OpenRouter (multi-provider gateway — access Claude, GPT, Gemini, Llama, etc. with one key).
# Get a key at https://openrouter.ai/keys
VITE_OPENROUTER_KEY=

# Supabase Auth (cloud login). Required for sign in / sign up to work:
# Project Settings -> API. URL is the Project URL, key is the anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Umbra OS backend (optional — if running the backend, set this to connect the frontend to it)
# Leave unset or empty to fall back to direct cloud AI calls.
VITE_BACKEND_URL=http://127.0.0.1:8787

# Samsung SmartThings (Smart Home tab). Create a personal access token at
# https://account.smartthings.com/tokens (scopes: devices, rooms; control for commands).
# In the packaged Electron app the token is read by the MAIN process:
#   SMARTTHINGS_TOKEN=...
# For plain `npm run dev` in the browser (uses the Vite proxy, which injects
# the Authorization header server-side) you can also set:
#   VITE_SMARTTHINGS_TOKEN=...
VITE_SMARTTHINGS_TOKEN=
VITE_SMARTTHINGS_URL=https://api.smartthings.com

# ═══ Multi-platform Smart Home hub (backend env — all optional) ═══
# Every platform can be connected per-user in the Smart Home tab instead
# (tokens are validated and stored encrypted in the credential vault).
# These env vars are pre-seeded defaults for self-hosted setups.

# Home Assistant — long-lived access token (Profile → Security) + server URL.
#   UMBRA_HA_URL=http://homeassistant.local:8123
UMBRA_HA_URL=

# Hubitat Elevation — Maker API: create a Maker API app on the hub, then set
# the hub URL, the Maker API app id (default 1) and its access token.
#   UMBRA_HUBITAT_URL=http://hubitat.local/apps/api/1/devices
UMBRA_HUBITAT_URL=
UMBRA_HUBITAT_APP_ID=1

# openHAB — REST API server URL (token via /api/smart/platforms/openhab/connect).
#   UMBRA_OPENHAB_URL=http://openhab.local:8080
UMBRA_OPENHAB_URL=

# Tuya / Smart Life — IoT cloud endpoint for your region:
#   https://openapi.tuyaus.com (Americas) | openapi.tuyaeu.com (EU) | openapi.tuyacn.com (CN)
UMBRA_TUYA_ENDPOINT=https://openapi.tuyaus.com
