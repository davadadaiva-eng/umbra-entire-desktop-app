# ── Meeting bot configuration ────────────────────────────────────────────────
# Copy to .env and fill in. Loaded automatically by docker compose.

# Quality tier: FREE (whisper base, ~140MB) | PRO (tiny) | ADVANCED (small)
PLAN=FREE

# ── LLM brain (the only required secret) ─────────────────────────────────────
# OpenRouter: https://openrouter.ai/keys  (model below bills as deepseek-chat)
LLM_API_KEY=

# Any OpenAI-compatible endpoint works. Defaults to OpenRouter.
# Local LLM on the same host example: http://host.docker.internal:11434/v1/chat/completions
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=deepseek/deepseek-chat

# Alternative to the API: your own brain webhook that receives
# {"transcript", "meeting_id", "command"} and returns {"response": "..."}.
# If set, it takes precedence over the API settings.
LLM_WEBHOOK_URL=

# ── API protection (required if you expose the port beyond SSH) ──────────────
# Generate one with: openssl rand -hex 24
# When set, every /bot/* route requires:  Authorization: Bearer <token>
# Failed attempts are rate-limited per IP (10/min -> 429) and /docs is hidden.
# Leave empty for open access (fine when only reachable via SSH tunnel).
API_TOKEN=

# Browser clients only: comma-separated list of origins allowed to call the
# API, e.g. https://app.example.com. Leave empty for non-browser use.
CORS_ORIGINS=

# ── Public HTTPS (optional, bundled Caddy reverse proxy) ─────────────────
# Public hostname for the API. Requires a DNS A record pointing at the VPS
# and firewall openings for 80+443 (keep 8000 closed). Caddy issues and
# renews the Let's Encrypt certificate automatically on first start.
# Empty DOMAIN + empty COMPOSE_PROFILES = loopback-only (SSH tunnel) setup.
DOMAIN=

# Set to "proxy" to start the Caddy service:  COMPOSE_PROFILES=proxy
# (the caddy:2 image is pulled on first start; without the profile nothing
# is exposed on 80/443.)
COMPOSE_PROFILES=
