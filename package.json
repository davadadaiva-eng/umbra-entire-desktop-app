{
  "name": "umbra-os",
  "version": "0.1.0",
  "private": true,
  "description": "Umbra OS — Invisible AI computer assistant for Windows",
  "scripts": {
    "build:backend": "cd backend && npm run build",
    "build:desktop": "cd desktop && npm run build",
    "build": "npm run build:backend && npm run build:desktop",
    "dev:backend": "cd backend && npm run dev",
    "dev:desktop": "cd desktop && npm run desktop",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:desktop\"",
    "start": "cd desktop && npm run desktop",
    "test": "cd backend && npm test",
    "lint": "cd backend && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
